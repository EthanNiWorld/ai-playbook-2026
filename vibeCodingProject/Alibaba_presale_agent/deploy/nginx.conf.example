# nginx 反代配置示例 — 域名解析到服务器后使用
# 放置到 /etc/nginx/sites-available/alibaba-presale-agent.conf 后 ln -s 到 sites-enabled 并 nginx -s reload
#
# 注意：SSE 需要 proxy_buffering off，已在配置中处理。

server {
    listen 80;
    server_name your-domain.example.com;   # ← 替换为你的域名

    # 如需 HTTPS（推荐）：用 certbot 一键申请
    #   sudo certbot --nginx -d your-domain.example.com
    # certbot 会自动改写本配置补充 443/证书段落

    client_max_body_size 4m;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # SSE 流式必需
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
    }
}

# ==== 必填 ====
# 百炼 API Key（阿里云百炼 OpenAI 兼容协议）
# 请将 <YOUR_API_KEY> 替换为真实 Key；workspace 专属 Key 需配合下方专属端点使用
DASHSCOPE_API_KEY=<YOUR_API_KEY>

# ==== 常用可选项 ====
# 国际站或 workspace 专属端点（留空则用默认北京端点）
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# 底层问答模型（默认 qwen3.8-max）
# QA_MODEL=qwen3.8-max

# 后台接口保护令牌（设置后 /api/admin/* 需带请求头 X-Admin-Token）
# 公网部署强烈建议设置：openssl rand -hex 16
# ADMIN_TOKEN=

# Tavily 搜索 API Key（不配则自动降级为 DuckDuckGo 免费方案）
# TAVILY_API_KEY=

# ==== 知识库 ====
# 知识来源仓库（默认拉取 ai-playbook-2026 的 alibaba-ai-hub/ 与 knowledge/ai-general-notes/）
# KNOWLEDGE_REPO_URL=https://github.com/EthanNiWorld/ai-playbook-2026.git

# 克隆模式下自动 git pull 间隔（小时）；后台服务也会按此间隔检查远端提交，
# 有新提交才拉取并重建索引（设 KB_AUTO_SYNC=0 可关闭该定时任务）
# KB_SYNC_INTERVAL_HOURS=24

# 知识库自动同步开关（默认开启；置 0 关闭定时检查）
# KB_AUTO_SYNC=1

# 官方定价页缓存有效期（小时）
# PRICE_PAGE_TTL_HOURS=6

# 本地开发：直接指定知识库仓库根目录（须含 alibaba-ai-hub/），跳过 GitHub 克隆
# 容器内不要设置本项
# LOCAL_KNOWLEDGE_PATH=/path/to/ai-playbook-2026

# ==== 仅 Docker 构建用（国内网络环境）====
# 构建期镜像源（可选，国内网络建议打开）
# 注意 pip 用清华源：阿里云 PyPI 镜像缺 pydantic==2.14.3，依赖解析会失败
# APT_MIRROR=mirrors.aliyun.com
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
